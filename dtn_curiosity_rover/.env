# Demo settings, read by docker compose. Values set in the shell take precedence.

# One-way light-time delay on the DTN link, in milliseconds (1300 is about the Moon)
LINK_DELAY_MS=5000

# DTN link network and the two nodes' addresses on it. The addresses are compiled into
# BPNode's contact tables, so run ./build.sh again after changing them.
DTN_LINK_SUBNET=172.28.10.0/24
DTN_GROUND_ADDR=172.28.10.10
DTN_ROVER_ADDR=172.28.10.20
